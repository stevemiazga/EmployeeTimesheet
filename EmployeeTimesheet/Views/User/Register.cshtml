@model EmployeeTimesheet.ViewModels.RegisterViewModel
<style>
    #Email, #WorkExt {
        border: 1px solid #808080;
    }
</style>
<div class="container-fluid full-width-container">
    <section class="container-fluid">
        <div class="row">
            <div class="login_container">
                <div class="row login_header">
                </div>
                <div class="row">

                    <form asp-controller="User" asp-action="Register" asp-route-returnurl="ViewBag.ReturnUrl" method="post" asp-antiforgery="true" class="form-horizontal" role="form">

                        <div class="form-group login_message_summary">
                            @if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count() > 0)
                            {
                                <div class="alert alert-dismissable alert-danger">
                                    <button class="close" type="button" data-dismiss="alert">×</button>
                                    <div asp-validation-summary="All"></div>
                                </div>
                            }
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="FirstName" class="control-label"></label></h4>
                            <div class="form-control-div">
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                            </div>
                            <span asp-validation-for="FirstName"></span>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="LastName" class="control-label"></label></h4>
                            <div class="form-control-div">
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                            </div>
                            <span asp-validation-for="LastName"></span>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="Email" class="control-label"></label></h4>
                            <div class="form-control-div">
                                <input asp-for="Email" class="form-control" placeholder="Enter email" />
                            </div>
                            <span asp-validation-for="Email"></span>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="WorkExt" class="control-label"></label></h4>
                            <div class="form-control-div">
                                <input asp-for="WorkExt" class="form-control" placeholder="Enter phone number" />
                            </div>
                            <span asp-validation-for="WorkExt"></span>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="DepartmentId" class="control-label"></label></h4>
                            <select asp-for="DepartmentId" asp-items='@new SelectList(ViewBag.DepartmentDropDown, "DepartmentId", "DepartmentDesc")'></select>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="StartTime" class="control-label"></label></h4>
                            <select asp-for="DepartmentId" asp-items='@new SelectList(ViewBag.StartTimeDropDown, "StartTimeValue", "StartTimeText")'></select>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="UserName" class="control-label"></label></h4>
                            <div class="form-control-div">
                                <input asp-for="UserName" class="form-control" placeholder="Enter user name" />
                            </div>
                            <span asp-validation-for="UserName"></span>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="Password" class="control-label"></label></h4>
                            <div class="form-control-div">
                                <input asp-for="Password" class="form-control" placeholder="Enter password" />
                            </div>
                            <span asp-validation-for="Password"></span>
                        </div>

                        <div class="form-group">
                            <h4><label asp-for="ConfirmPassword" class="control-label"></label></h4>
                            <div class="form-control-div">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Enter password again" />
                            </div>
                            <span asp-validation-for="ConfirmPassword"></span>
                        </div>


                        <div class="form-group clearfix">
                            <input type="submit" value="Register" class="submitbutton" style="float:left;" />&nbsp;&nbsp;
                            <a class="submitbutton" style="text-decoration:none;float:left;margin-left:10px;padding-bottom:4px;" asp-action="Index" asp-controller="Home">Cancel</a>
                        </div>

                    </form>



                </div>
            </div>
        </div>
    </section>
</div>
